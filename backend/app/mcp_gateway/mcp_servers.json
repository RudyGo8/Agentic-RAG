{
  "github": {
    "enabled": true,
    "transport": "streamable_http",
    "url": "https://api.githubcopilot.com/mcp/",
    "headers": {
      "Authorization": "Bearer ${GITHUB_PAT_TOKEN}"
    }
  },
  "mysql": {
    "enabled": true,
    "transport": "stdio",
    "command": "python",
    "args": ["-m", "mysql_mcp_server.server"],
    "env": {
      "MYSQL_HOST": "${MYSQL_MCP_HOST}",
      "MYSQL_PORT": "${MYSQL_MCP_PORT}",
      "MYSQL_USER": "${MYSQL_MCP_USERNAME}",
      "MYSQL_PASSWORD": "${MYSQL_MCP_PASSWORD}",
      "MYSQL_DATABASE": "${MYSQL_MCP_DATABASE}",
      "ALLOW_WRITE_OPERATIONS": "false"
    }
  }
}