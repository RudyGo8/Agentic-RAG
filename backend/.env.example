# ===== 模型（必填）=====
# LLM API Key（OpenAI 兼容接口）
ARK_API_KEY=
# 主模型名
MODEL=qwen-plus
# OpenAI 兼容接口地址
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 评分/重写用模型
GRADE_MODEL=qwen-plus

# 向量模型
EMBEDDER=text-embedding-v2
EMBEDDING_DIM=1536

# ===== 基础服务（默认值对应根目录 docker-compose.yml）=====
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_DATABASE=rag_mysql

REDIS_URL=redis://localhost:6379/0

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_embeddings

# ===== JWT 鉴权 =====
# 生产环境务必修改
JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# 注册邀请码，为空则不校验
ADMIN_INVITE_CODE=

# ===== RAG =====
AUTO_MERGE_ENABLED=true
AUTO_MERGE_THRESHOLD=2
LEAF_RETRIEVE_LEVEL=3

# ===== MCP 工具 =====
# 开启后加载 Git / MySQL 等 MCP 工具
MCP_ENABLED=false

# ===== RAGAS 评测（缺省复用上面的模型配置）=====
RAGAS_LLM_MODEL=qwen-plus
RAGAS_EMBEDDING_MODEL=text-embedding-v2

# ===== 日志 =====
# development 彩色输出 / production JSON
ENV=development
LOG_LEVEL=INFO
